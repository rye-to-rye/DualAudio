<ui:FluentWindow x:Class="DualAudio.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:DualAudio.App.ViewModels"
                 xmlns:local="clr-namespace:DualAudio.App.Views"
                 xmlns:conn="clr-namespace:DualAudio.Core.Connection;assembly=DualAudio.Core"
                 xmlns:errors="clr-namespace:DualAudio.Core.Errors;assembly=DualAudio.Core"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
                 Title="DualAudio"
                 Width="960" Height="640" MinWidth="780" MinHeight="560"
                 Icon="pack://application:,,,/DualAudio;component/Assets/DualAudio.ico"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DualAudio;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" TextElement.Foreground="{StaticResource TextBrush}"
          TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="{StaticResource BodyFontSize}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Header (in the caption bar): [back, settings page only] monogram, name / "Settings", status pill, [Settings, dashboard only].
            Shell = ShellViewModel (window property): which page is shown.
        -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" />
        <ui:TitleBar Grid.Row="0" Height="{StaticResource HeaderHeight}" ShowMaximize="False"
                     ButtonsForeground="{StaticResource TextMutedBrush}">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Button x:Name="BackButton" Margin="0,0,12,0" Style="{StaticResource IconButton}" Width="36" Height="36"
                            Command="{Binding Shell.GoBackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding Shell.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Back to the dashboard" AutomationProperties.Name="Back to dashboard">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource BackIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" />
                        </Viewbox>
                    </Button>
                    <Image Source="{StaticResource MonogramImage}" Width="26" Height="26" />
                    <TextBlock Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderTitle}">
                                <Setter Property="Text" Value="DualAudio" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Shell.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Text" Value="Settings" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Style="{StaticResource StatusPill}" AutomationProperties.Name="Connection status">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusPillDot" Style="{StaticResource StatusDot}" Fill="{Binding StatusTone, Converter={StaticResource StatusToneBrush}}" />
                            <TextBlock x:Name="StatusPillText" Margin="8,0,0,0" FontSize="{StaticResource SmallFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{Binding StatusTone, Converter={StaticResource StatusToneBrush}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding StatusText}" />
                                        <Style.Triggers>
                                            <!-- In Error the pill names the problem ("Bluetooth is off") instead of "Error". -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Error}" />
                                                    <Condition Binding="{Binding IsErrorVisible}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="{Binding Error.Title}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" Margin="12,0,0,0" Style="{StaticResource IconButton}"
                            Command="{Binding Shell.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding Shell.IsDashboardPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Settings" AutomationProperties.Name="Settings">
                        <TextBlock Style="{StaticResource SettingsGlyph}" FontSize="18" />
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Settings page (its own view model; created when the page opens, released when it closes) -->
        <local:SettingsPage x:Name="SettingsHost" Grid.Row="1"
                            DataContext="{Binding Shell.SettingsPage, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding Shell.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <!-- Dashboard page -->
        <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Shell.IsDashboardPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="{StaticResource WindowPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="{StaticResource CardGapLength}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ======================== Left column -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="250" />
                    </Grid.RowDefinitions>

                    <!-- Phone card: icon, name, state line, one action -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="{StaticResource CardGapBelow}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <!-- Not found: Retry (looks again, with automatic retries) -->
                                <Button Content="Retry" Command="{Binding RetryFindPhoneCommand}"
                                        Visibility="{Binding IsPhoneNotFound, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource PrimaryButton}" />
                                <!-- Error with an action: "Open Bluetooth settings" / "Retry" -->
                                <Button Content="{Binding Error.ActionLabel}" Command="{Binding ErrorActionCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Error}" />
                                                        <Condition Binding="{Binding HasErrorAction}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Connect -->
                                <Button Content="Connect" Command="{Binding ConnectCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConnectVisible}" Value="True" />
                                                        <Condition Binding="{Binding IsPhoneNotFound}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Error}" />
                                                        <Condition Binding="{Binding HasErrorAction}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Disconnect ("Cancel" while reconnecting) -->
                                <Button Command="{Binding DisconnectCommand}"
                                        Visibility="{Binding IsDisconnectVisible, Converter={StaticResource BoolToVisibility}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Disconnect" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Disconnected}">
                                                    <Setter Property="Content" Value="Cancel" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <Border DockPanel.Dock="Left" Width="48" Height="48" Style="{StaticResource Tile}" Padding="0" CornerRadius="{StaticResource CardRadius}">
                                <Path Width="20" Height="30" Data="{StaticResource PhoneIcon}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" />
                            </Border>

                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDevice.Name, FallbackValue='No phone yet', TargetNullValue='No phone yet'}"
                                           FontSize="{StaticResource PhoneNameFontSize}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PhoneStateLine" Margin="0,4,0,0" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"
                                           Foreground="{Binding StatusTone, Converter={StaticResource StatusToneBrush}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Not connected" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Enabling}">
                                                    <Setter Property="Text" Value="Connecting…" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Opening}">
                                                    <Setter Property="Text" Value="Connecting…" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.WaitingForPhone}">
                                                    <Setter Property="Text" Value="Waiting for the phone to appear…" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Connected}">
                                                    <Setter Property="Text" Value="Connected · nothing playing on the phone" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Connected}" />
                                                        <Condition Binding="{Binding IsReceivingAudio}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Connected · receiving audio" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Disconnected}" />
                                                        <Condition Binding="{Binding IsDisconnectVisible}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Lost the link, trying again" />
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Error}">
                                                    <Setter Property="Text" Value="Saved phone" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPhoneNotFound}" Value="True">
                                                    <Setter Property="Text" Value="Saved phone · not reachable" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Only in the yellow "Connected, not receiving" state: clean reconnect (Prompt 9). -->
                                <Button x:Name="FixAudioLink" Margin="0,6,0,0" HorizontalAlignment="Left" Content="No sound? Fix audio"
                                        Command="{Binding FixAudioCommand}" Style="{StaticResource LinkButton}"
                                        AutomationProperties.Name="Fix audio"
                                        Visibility="{Binding IsFixAudioVisible, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Banners: error (incl. "Can't reach your phone" while retrying) and the calm "Phone not found" -->
                    <StackPanel Grid.Row="1">
                        <!-- Quiet "Update ready" banner (Prompt 10): never restarts by itself. -->
                        <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Padding="16,14" Margin="{StaticResource CardGapBelow}"
                                Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource InfoIcon}" />
                                </Viewbox>
                                <StackPanel>
                                    <TextBlock Text="Update ready" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding UpdateBannerText}" Style="{StaticResource MutedText}" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Button Content="Restart now" Command="{Binding RestartToUpdateCommand}" Style="{StaticResource LinkButton}" />
                                        <Button Margin="20,0,0,0" Content="Later" Command="{Binding UpdateLaterCommand}" Style="{StaticResource LinkButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="{StaticResource CardGapBelow}"
                                Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0">
                                    <Path Data="{StaticResource InfoIcon}">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Error.Kind}" Value="{x:Static errors:ErrorKind.BluetoothOff}">
                                                        <Setter Property="Stroke" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Error.Kind}" Value="{x:Static errors:ErrorKind.NoAdapter}">
                                                        <Setter Property="Stroke" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Viewbox>
                                <StackPanel>
                                    <TextBlock Text="{Binding Error.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Error.Message}" Style="{StaticResource MutedText}" />
                                    <!-- While retrying the card shows Cancel; "Retry now" stays available here. -->
                                    <Button Margin="0,8,0,0" Content="{Binding Error.ActionLabel}" Command="{Binding ErrorActionCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ConnectionState}" Value="{x:Static conn:ConnectionState.Disconnected}" />
                                                            <Condition Binding="{Binding HasErrorAction}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="{StaticResource CardGapBelow}"
                                Visibility="{Binding IsPhoneNotFound, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource InfoIcon}" />
                                </Viewbox>
                                <StackPanel>
                                    <TextBlock Text="Phone not found" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding PhoneNotFoundMessage}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Phone volume -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid IsEnabled="{Binding IsPhoneAudioAvailable}" Background="Transparent"
                              ToolTip="{Binding PhoneAudioToolTip}" ToolTipService.ShowOnDisabled="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Right" Text="Game audio is never changed" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" />
                                <TextBlock Text="Phone volume" Style="{StaticResource CardHeading}" />
                            </DockPanel>
                            <DockPanel Grid.Row="1" Margin="0,18,0,0">
                                <TextBlock DockPanel.Dock="Left" Width="92" Margin="0,0,20,0" Style="{StaticResource BigNumber}" VerticalAlignment="Center">
                                    <Run Text="{Binding PhoneVolume, Mode=OneWay}" /><Run Text="%" FontSize="18" Foreground="{StaticResource TextMutedBrush}" />
                                </TextBlock>
                                <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                        VerticalAlignment="Center" Value="{Binding PhoneVolume}" AutomationProperties.Name="Phone volume" />
                            </DockPanel>
                            <!-- Phone level (MinDashboard): dimmed while muted, so the user sees audio still arriving -->
                            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                <TextBlock Text="Phone level" Style="{StaticResource MutedText}" />
                                <ProgressBar x:Name="DashboardLevelMeter" Margin="0,8,0,0" Value="{Binding DashboardLevel.Level, Mode=OneWay}"
                                             AutomationProperties.Name="Phone level">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource LevelMeter}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0">
                                <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding IsMuted}" AutomationProperties.Name="Mute phone">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                            <Path Data="{StaticResource MuteIcon}">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                                        <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource SpeakerIcon}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Viewbox>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Mute phone" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Text" Value="Unmute phone" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                                <!-- "or press Ctrl Alt M": the current mute shortcut from the hotkey settings -->
                                <StackPanel x:Name="MuteShortcutHint" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasMuteShortcut, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="or press" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ItemsControl ItemsSource="{Binding MuteShortcutKeys}" Focusable="False" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource KbdChip}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource KbdText}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ======================== Right column -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="{StaticResource CardGapBelow}">
                        <StackPanel>
                            <TextBlock Text="Output" Style="{StaticResource CardHeading}" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding OutputDeviceName}" FontSize="{StaticResource CardHeadingFontSize}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Text="Windows default · phone audio follows it" Style="{StaticResource MutedText}" />
                            <Button Margin="0,12,0,0" Content="Per-app output settings" Command="{Binding OpenPerAppOutputSettingsCommand}"
                                    Style="{StaticResource LinkButton}" />
                        </StackPanel>
                    </Border>

                    <!-- Phone choice (kept from the previous dashboard; the mockup has no picker) -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Phones" Style="{StaticResource CardHeading}" Margin="0,0,0,12" />
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Phone" IsEnabled="{Binding IsConnectVisible}" />
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <Button Content="Add a phone" Command="{Binding AddPhoneCommand}" Style="{StaticResource LinkButton}"
                                        ToolTip="Pair a phone in Windows Settings &gt; Bluetooth &amp; devices" />
                                <Button Margin="20,0,0,0" Content="Forget in DualAudio" Command="{Binding ForgetDeviceCommand}" Style="{StaticResource LinkButton}"
                                        ToolTip="Removes this phone from DualAudio only. It stays paired in Windows." />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Text="Forget only removes it from DualAudio; it stays paired in Windows." Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
