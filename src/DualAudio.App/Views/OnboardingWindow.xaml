<ui:FluentWindow x:Class="DualAudio.App.Views.OnboardingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:DualAudio.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
                 Title="Set up DualAudio"
                 Width="640" Height="600" MinWidth="560" MinHeight="480"
                 Icon="pack://application:,,,/DualAudio;component/Assets/DualAudio.ico"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DualAudio;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Step progress bar: accent once the step is reached. -->
            <Style x:Key="StepBar" TargetType="Border">
                <Setter Property="Height" Value="4" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Background" Value="{StaticResource LineBrush}" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" TextElement.Foreground="{StaticResource TextBrush}"
          TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="{StaticResource BodyFontSize}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="44" ShowMaximize="False" ButtonsForeground="{StaticResource TextMutedBrush}">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                    <Image Source="{StaticResource MonogramImage}" Width="20" Height="20" />
                    <TextBlock Margin="10,0,0,0" Text="DualAudio" FontSize="{StaticResource SmallFontSize}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- "Set up DualAudio · Step N of 4" + 4 bars -->
        <StackPanel Grid.Row="1" Margin="32,8,32,0">
            <TextBlock Style="{StaticResource MutedText}">
                <Run Text="Set up DualAudio · Step" /> <Run Text="{Binding StepNumber, Mode=OneWay}" /> <Run Text="of 4" />
            </TextBlock>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource StepBar}" Background="{StaticResource AccentBrush}" />
                <Border Grid.Column="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StepBar}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:OnboardingStep.Pair}">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:OnboardingStep.PickPhone}">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:OnboardingStep.Connect}">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Grid.Column="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StepBar}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:OnboardingStep.PickPhone}">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:OnboardingStep.Connect}">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Grid.Column="6">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StepBar}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:OnboardingStep.Connect}">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,22,32,16">

                <!-- ======================== 1. Checks -->
                <StackPanel Visibility="{Binding IsChecksStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Check this PC" Style="{StaticResource PageTitle}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" FontSize="{StaticResource BodyFontSize}" LineHeight="21"
                               Text="DualAudio plays your phone's audio through this PC's headset, together with your game. First, a quick check." />
                    <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Checks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CheckRow}">
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,8">
                                    <DockPanel>
                                        <!-- Passed: accent check. Failed: warning "!" (no red/green in the palette). -->
                                        <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0">
                                            <Path>
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                                        <Setter Property="Data" Value="{StaticResource InfoIcon}" />
                                                        <Setter Property="Stroke" Value="{StaticResource WarningBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource CheckIcon}" />
                                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="StrokeThickness" Value="2.2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0" Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="{Binding FixLabel}"
                                                    Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,4,0,0" Text="{Binding RadioMessage}" Style="{StaticResource WarningText}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Check again" Command="{Binding CheckAgainCommand}" />
                        <!-- Static text instead of a spinner: no animations. -->
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Checking…" Style="{StaticResource MutedText}"
                                   Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <!-- ======================== 2. Pair -->
                <StackPanel Visibility="{Binding IsPairStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Pair your phone" Style="{StaticResource PageTitle}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding PairInstruction}" Style="{StaticResource MutedText}"
                               FontSize="{StaticResource BodyFontSize}" LineHeight="21" />
                    <Border Margin="0,18,0,0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="This PC is called" Style="{StaticResource MutedText}" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding PcBluetoothName}" FontSize="{StaticResource PhoneNameFontSize}" FontWeight="Bold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Open Bluetooth settings" Command="{Binding OpenBluetoothSettingsCommand}" />
                        <TextBlock Text="{x:Static vm:OnboardingText.KeepSettingsOpen}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Margin="0,16,0,0" Style="{StaticResource OutlineCard}">
                        <StackPanel>
                            <TextBlock Text="iPhone" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding IPhonePairTip}" Style="{StaticResource MutedText}" />
                            <TextBlock Margin="0,12,0,0" Text="Android" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding AndroidPairTip}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,12,0,0" Text="Already paired? Just press Next." Style="{StaticResource MutedText}" />
                </StackPanel>

                <!-- ======================== 3. Pick phone (MinOnboarding step 3) -->
                <StackPanel Visibility="{Binding IsPickStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Pick your phone" Style="{StaticResource PageTitle}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" FontSize="{StaticResource BodyFontSize}" LineHeight="21"
                               Text="These are paired devices that can send audio to this PC." />

                    <Border Margin="0,18,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource OutlineCard}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDevices}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Waiting for your phone to appear… Finish pairing on the phone." Style="{StaticResource MutedText}" />
                    </Border>

                    <ListBox Margin="0,18,0,0" MaxHeight="200" Style="{StaticResource RadioCardList}"
                             ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutomationProperties.Name="Paired phones"
                             Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource CardHeadingFontSize}" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,0" Text="Paired · ready" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0,10,0,0" FontWeight="SemiBold">
                        <Run Text="Nickname" /> <Run Text="(optional, only shown in DualAudio)" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" />
                    </TextBlock>
                    <TextBox Margin="0,8,0,0" Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                             Tag="e.g. My iPhone" AutomationProperties.Name="Nickname" />
                    <Button Margin="0,16,0,0" Content="Don't see your phone?" Command="{Binding OpenBluetoothSettingsCommand}"
                            Style="{StaticResource LinkButton}" ToolTip="Opens Settings &gt; Bluetooth &amp; devices" />
                </StackPanel>

                <!-- ======================== 4. Play something (MinOnboarding step 4) -->
                <StackPanel Visibility="{Binding IsConnectStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Play something on your phone" Style="{StaticResource PageTitle}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" FontSize="{StaticResource BodyFontSize}" LineHeight="21"
                               Text="Start a video or song on your phone: as soon as DualAudio hears it, setup is done." />

                    <Border Margin="0,18,0,0" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Margin="0,0,12,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsConnectErrorVisible}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectStatus}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="16,14"
                            Visibility="{Binding IsConnectErrorVisible, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource InfoIcon}" Stroke="{StaticResource WarningBrush}" />
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding ConnectError.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding ConnectError.Action}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource OutlineCard}"
                            Visibility="{Binding IsMutedHintVisible, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Unmute" Command="{Binding UnmuteCommand}" Style="{StaticResource PrimaryButton}" />
                            <TextBlock Text="{x:Static vm:OnboardingText.MutedHint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource OutlineCard}"
                            Visibility="{Binding IsNoAudioHelpVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Not hearing it?" FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0" Text="{x:Static vm:OnboardingText.NoAudioHelp}" Style="{StaticResource MutedText}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding IPhoneNoAudioTip}" Style="{StaticResource MutedText}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding AndroidNoAudioTip}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Border>

                    <Button Margin="0,16,0,0" Content="Try again" Command="{Binding TryAgainCommand}" Style="{StaticResource LinkButton}"
                            ToolTip="Reconnect to the phone" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer: Back · Skip ……… Next / Connect / Waiting… / Done -->
        <Border Grid.Row="3" Margin="32,0,32,24" Padding="0,16,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Skip" Command="{Binding SkipCommand}" Style="{StaticResource LinkButton}"
                        Visibility="{Binding CanSkip, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Command="{Binding FinishCommand}" MinWidth="110"
                        Visibility="{Binding IsConnectStep, Converter={StaticResource BoolToVisibility}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Waiting…" />
                            <Setter Property="Padding" Value="22,0" />
                            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                    <Setter Property="Content" Value="Done" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding NextCommand}" MinWidth="110"
                        Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVisibility}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Next" />
                            <Setter Property="Padding" Value="22,0" />
                            <Setter Property="Height" Value="{StaticResource ControlHeight}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPickStep}" Value="True">
                                    <Setter Property="Content" Value="Connect" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Margin="0,0,10,0" Content="Back" Command="{Binding BackCommand}" Height="{StaticResource ControlHeight}" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
