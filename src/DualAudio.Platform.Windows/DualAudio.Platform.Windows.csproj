<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinRT / CoreAudio / Win32 adapters implementing Core interfaces. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DualAudio.Platform.Windows</RootNamespace>
    <!-- For [LibraryImport]-generated stubs (GetGuiResources), as in DualAudio.App. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DualAudio.Core\DualAudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DualAudio.Platform.Tests" />
  </ItemGroup>

</Project>
