<!--
    Design tokens (docs/design/README.md; same values as the website). The ONLY place colours, radii, spacing and
    font sizes are defined: every window and style uses these keys. No effects of any kind (runs next to games).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Colours -->
    <Color x:Key="BackgroundColor">#0B0D10</Color>
    <Color x:Key="RaisedColor">#14171C</Color>
    <Color x:Key="Raised2Color">#1B1F26</Color>
    <Color x:Key="LineColor">#2A2F38</Color>
    <Color x:Key="TextColor">#E8EAED</Color>
    <Color x:Key="TextMutedColor">#A9B0BB</Color>
    <Color x:Key="AccentColor">#7C9CFF</Color>
    <Color x:Key="AccentHoverColor">#9DB5FF</Color>
    <Color x:Key="OnAccentColor">#0B0D10</Color>
    <Color x:Key="WarningColor">#F5C062</Color>

    <!-- Brushes (frozen: no animation, cheap to share) -->
    <SolidColorBrush x:Key="BackgroundBrush" po:Freeze="True" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="RaisedBrush" po:Freeze="True" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Raised2Brush" po:Freeze="True" Color="{StaticResource Raised2Color}" />
    <SolidColorBrush x:Key="LineBrush" po:Freeze="True" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="TextBrush" po:Freeze="True" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" po:Freeze="True" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" po:Freeze="True" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" po:Freeze="True" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" po:Freeze="True" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="WarningBrush" po:Freeze="True" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="TransparentBrush" po:Freeze="True" Color="Transparent" />

    <!-- Radii -->
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlRadius">10</CornerRadius>
    <CornerRadius x:Key="SmallRadius">8</CornerRadius>
    <CornerRadius x:Key="ChipRadius">6</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>
    <sys:Double x:Key="ControlRadiusValue">10</sys:Double>

    <!-- Spacing -->
    <Thickness x:Key="WindowPadding">24</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardGapBelow">0,0,0,16</Thickness>
    <Thickness x:Key="CardGapRight">0,0,16,0</Thickness>
    <sys:Double x:Key="CardGap">16</sys:Double>
    <GridLength x:Key="CardGapLength">16</GridLength>
    <sys:Double x:Key="HeaderHeight">60</sys:Double>
    <sys:Double x:Key="ControlHeight">42</sys:Double>
    <sys:Double x:Key="SmallControlHeight">36</sys:Double>

    <!-- Type -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="BigNumberFontSize">40</sys:Double>
    <sys:Double x:Key="PageTitleFontSize">24</sys:Double>
    <sys:Double x:Key="PhoneNameFontSize">20</sys:Double>
    <sys:Double x:Key="WindowTitleFontSize">18</sys:Double>
    <sys:Double x:Key="HeaderTitleFontSize">16</sys:Double>
    <sys:Double x:Key="CardHeadingFontSize">15</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SmallFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
</ResourceDictionary>
